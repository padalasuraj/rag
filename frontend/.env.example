# NexusRAG frontend environment
#
# The app talks to the backend over a relative /api path by default, which the
# Vite dev server (see vite.config.ts) and the nginx production build both proxy
# to the FastAPI backend. You normally do NOT need to change this.
#
# Only override this if you host the API on a different origin (e.g. a separate
# Render/Fly service) and are NOT proxying through the same domain.
# VITE_API_URL=https://your-backend.onrender.com/api

# Where the Vite dev server proxies /api during `npm run dev`.
# Defaults to http://localhost:8000 (see vite.config.ts).
# VITE_PROXY_TARGET=http://localhost:8000
