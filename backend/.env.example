# =========================================================================
# NexusRAG backend configuration. Copy to `.env` and fill in your secrets.
# NEVER commit the real .env file.
# =========================================================================

# ---- App ----
ENVIRONMENT=development
LOG_LEVEL=INFO
API_PREFIX=/api
# Comma-separated allowed frontend origins (dev + preview).
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ---- Storage ----
# SQLite by default => no database to install. For Postgres use e.g.
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/nexusrag
DATABASE_URL=sqlite:///./nexusrag.db
STORAGE_DIR=./storage
CHROMA_DIR=./storage/chroma

# ---- LLM (OpenAI or any OpenAI-compatible endpoint) ----
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here
# Optional: point at Azure OpenAI / OpenRouter / a local server.
# OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# ---- Embeddings ----
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=96

# ---- Vector store: "chroma" (default, local) or "pinecone" ----
VECTOR_STORE=chroma
# Only needed when VECTOR_STORE=pinecone:
PINECONE_API_KEY=
PINECONE_INDEX=nexusrag
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ---- RAG tuning ----
CHUNK_SIZE=900
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=12
RERANK_TOP_N=5
SIMILARITY_THRESHOLD=0.18
MMR_LAMBDA=0.6

# ---- Uploads ----
MAX_UPLOAD_MB=25
ALLOWED_UPLOAD_TYPES=application/pdf
