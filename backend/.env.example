# =========================================================================
# NexusRAG backend configuration. Copy to `.env` and adjust for your machine.
# No API key or paid AI service is required.
# =========================================================================

# ---- App ----
ENVIRONMENT=development
LOG_LEVEL=INFO
API_PREFIX=/api
# Comma-separated allowed frontend origins (dev + preview).
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ---- Storage ----
# SQLite by default => no database to install. For Postgres use e.g.
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/nexusrag
DATABASE_URL=sqlite:///./nexusrag.db
STORAGE_DIR=./storage
CHROMA_DIR=./storage/chroma

# ---- LLM: local Ollama ----
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT_SECONDS=120
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# ---- Embeddings: local Sentence Transformers ----
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=64

# ---- Vector store: "chroma" (default, local) or "pinecone" ----
VECTOR_STORE=chroma
# Optional: override the generated Chroma collection name.
# CHROMA_COLLECTION=
# Only needed when VECTOR_STORE=pinecone:
PINECONE_API_KEY=
PINECONE_INDEX=nexusrag
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ---- RAG tuning ----
CHUNK_SIZE=900
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=12
RERANK_TOP_N=5
SIMILARITY_THRESHOLD=0.18
MMR_LAMBDA=0.6

# ---- Uploads ----
MAX_UPLOAD_MB=25
ALLOWED_UPLOAD_TYPES=application/pdf
